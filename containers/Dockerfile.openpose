FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

ARG OPENPOSE_COMMIT=8ca5c1d
ARG BUILD_JOBS=8
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace/src:/opt/openpose/build/python \
    OPENPOSE_PYTHON_PATH=/opt/openpose/build/python
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git libatlas-base-dev libboost-all-dev \
      libgflags-dev libgoogle-glog-dev libhdf5-dev libleveldb-dev \
      liblmdb-dev libopencv-dev libprotobuf-dev libsnappy-dev \
      protobuf-compiler python3 python3-dev python3-pip \
    && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/CMU-Perceptual-Computing-Lab/openpose.git /opt/openpose \
    && cd /opt/openpose \
    && git checkout "$OPENPOSE_COMMIT" \
    && git submodule update --init --recursive \
    && mkdir build \
    && cd build \
    && cmake -DBUILD_PYTHON=ON -DDOWNLOAD_BODY_25_MODEL=ON .. \
    && make -j"${BUILD_JOBS}"
WORKDIR /workspace
COPY requirements/openpose.txt requirements/openpose.txt
RUN python3 -m pip install --no-cache-dir -r requirements/openpose.txt
COPY src src
COPY runners/openpose runners/openpose
ENTRYPOINT ["python3", "runners/openpose/run.py"]
