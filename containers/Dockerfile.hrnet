FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace/src
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY requirements/hrnet.txt requirements/hrnet.txt
RUN python3 -m pip install --no-cache-dir \
      torch==2.1.0 torchvision==0.16.0 openmim==0.3.9 \
    && mim install mmengine==0.10.7 mmcv==2.1.0 \
    && python3 -m pip install --no-cache-dir -r requirements/hrnet.txt
COPY src src
COPY runners/hrnet runners/hrnet
ENTRYPOINT ["python3", "runners/hrnet/run.py"]
